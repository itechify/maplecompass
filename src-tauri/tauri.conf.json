{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MapleCompass",
  "version": "0.1.0",
  "identifier": "com.itechify.maplecompass",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "MapleCompass",
        "url": "index.html",
        "width": 340,
        "height": 72,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
